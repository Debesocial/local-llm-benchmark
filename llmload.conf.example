{
  "lang": "en",
  "url": "http://localhost:8000/v1/chat/completions",
  "model": "qwen-30b",
  "key": "",
  "save_key": false,
  "max_tokens": 400,
  "min_tokens": 0,
  "ignore_eos": false,
  "temperature": 0.7,
  "prompts": null,
  "pad_words": "0",
  "system_words": 0,
  "prefix_mode": "shared",
  "turns": 1,
  "think_min": 10.0,
  "think_max": 60.0,
  "stagger": 10.0,
  "warmup": 30.0,
  "cooldown": 5.0,
  "timeout": 300.0,
  "seed": 42,
  "usage": true,
  "insecure": false,
  "out": "hasil",
  "html": true,
  "quiet": false,
  "target_ttft": 3.0,
  "target_error": 0.01,
  "target_tps": 15.0,
  "ttft_basis": "token",
  "requests": 10,
  "levels": "5,10,20,30",
  "rates": "0.5,1,2,4",
  "arrival": "poisson",
  "max_concurrency": 128,
  "duration": 300,
  "level_pause": 30,
  "users": 30,
  "metrics_url": "",
  "metrics_interval": 5.0
}
